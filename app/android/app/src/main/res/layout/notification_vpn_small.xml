<?xml version="1.0" encoding="utf-8"?>
<!-- Свёрнутое уведомление VPN: логотип по кругу слева, справа заголовок и
     строка «пинг · трафик». Шапку (название, ключ, таймер) и кнопку
     «Отключить» рисует система — стиль DecoratedCustomViewStyle. Цвет текста
     — системные стили уведомлений: подходят и к светлой, и к тёмной шторке. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_notification_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" />
    </LinearLayout>
</LinearLayout>
