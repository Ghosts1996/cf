<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- [ИСПРАВЛЕНО — критичный баг, ломал ВСЁ приложение в релизе]
         debug/profile AndroidManifest.xml Flutter-шаблона объявляют
         INTERNET сами по себе — но ТОЛЬКО для debug/profile сборок ("The
         INTERNET permission is required for development"). В release-манифесте
         (этом файле) разрешения не было вообще. Именно release-APK
         собирает и подписывает GitHub Actions (build-android.yml, шаг
         "flutter build apk" с флагом release) и именно его получают
         реальные пользователи —
         без явного объявления здесь Android НЕ дал бы приложению открыть ни
         один сокет: ни вход по email/паролю, ни /user/keys, ни сам
         VLESS-туннель через flutter_singbox_client физически не смогли бы
         достучаться до сети, при этом само приложение запускалось бы без
         видимого краша — просто каждый запрос падал бы с сетевой ошибкой. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- [НОВОЕ] Требуется под capable VpnService/foreground-сервис пакета
         flutter_singbox_client — без него системный туннель не поднимется
         на Android (сервис, который держит tun-интерфейс, обязан быть
         foreground-сервисом с этим типом на Android 14+/API 34+, иначе ОС
         останавливает такой сервис при уходе приложения в фон). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- [ИСПРАВЛЕНО — причина "PlatformException(CONNECT_FAILED, Service
         failed to start)"] Начиная с Android 14 (API 34) каждый
         android:foregroundServiceType требует СВОЁ отдельное разрешение.
         Для типа "vpn" (его использует нативный foreground-сервис пакета
         flutter_singbox_client, держащий tun-интерфейс) это разрешение —
         FOREGROUND_SERVICE_VPN. Без него система отказывает в запуске
         foreground-сервиса с этим типом ещё до того, как код доходит до
         поднятия самого VPN — отсюда ошибка сразу на всех серверах, а не
         на каком-то одном ключе. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_VPN"/>
    <!-- [НОВОЕ] Android 13+ (API 33+) требует отдельное runtime-разрешение
         на показ ЛЮБЫХ уведомлений, включая постоянное уведомление туннеля
         (NotificationConfig в tunnel_service.dart, showTrafficStats/
         showStopButton) — без объявления этого разрешения в манифесте
         системное уведомление о статусе VPN не показывалось бы на новых
         версиях Android, даже если сам туннель работает. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- [ИСПРАВЛЕНО] Указано как обязательный шаг в NATIVE_SETUP.md, но не
         было добавлено: без этого разрешения InstalledApps.getInstalledApps()
         на экране split-tunnel (split_tunnel_screen.dart) вернёт пустой
         список или кинет исключение на Android 11+ (пакетная видимость). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>
    <application
        android:label="vpnonline_app"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>