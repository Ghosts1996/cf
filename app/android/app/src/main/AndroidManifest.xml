<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- INTERNET объявлен здесь, а не только в debug/profile-манифестах
         шаблона Flutter: релизная сборка их не использует, и без этой
         строки приложение в релизе не откроет ни одного сокета — ни вход,
         ни /user/keys, ни сам VLESS-туннель. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Нужны foreground-сервису flutter_singbox_client, который держит
         tun-интерфейс: на Android 14+ такой сервис обязан быть foreground с
         соответствующим типом, иначе ОС останавливает его при уходе
         приложения в фон. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- С Android 14 (API 34) каждый android:foregroundServiceType требует
         своё разрешение; для типа "vpn" это FOREGROUND_SERVICE_VPN. Без
         него система отказывает в запуске сервиса ещё до поднятия самого
         VPN — PlatformException(CONNECT_FAILED) сразу на всех серверах. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_VPN"/>
    <!-- Android 13+ (API 33+) требует runtime-разрешение на любые
         уведомления, включая постоянное уведомление туннеля
         (NotificationConfig в tunnel_service.dart). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Без этого разрешения InstalledApps.getInstalledApps() на экране
         split-tunnel вернёт пустой список или бросит исключение на
         Android 11+ (пакетная видимость). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>
    <application
        android:label="VPNonLine"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Схема для кнопки "Открыть в Hiddify"
             (TunnelService.buildHiddifyImportUri). QUERY_ALL_PACKAGES выше
             эту видимость формально даёт, но узкое объявление схемы
             предпочтительнее: Google Play отдельно проверяет обоснование
             QUERY_ALL_PACKAGES, а без этой записи canLaunchUrl() на API 30+
             может не увидеть установленный Hiddify и уйти в фолбэк на
             Google Play. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="hiddify"/>
        </intent>
    </queries>
</manifest>